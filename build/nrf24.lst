 102:Core/Src/radio/nrf24.c **** // Check if the nRF24L01 present
 103:Core/Src/radio/nrf24.c **** // return:
 104:Core/Src/radio/nrf24.c **** //   1 - nRF24L01 is online and responding
 105:Core/Src/radio/nrf24.c **** //   0 - received sequence differs from original
 106:Core/Src/radio/nrf24.c **** uint8_t nRF24_Check(const NRF24_TypeDef *nrf) {
 107:Core/Src/radio/nrf24.c **** 	uint8_t rxbuf[5];
 108:Core/Src/radio/nrf24.c **** 	uint8_t i;
 109:Core/Src/radio/nrf24.c **** 	uint8_t *ptr = (uint8_t *)nRF24_TEST_ADDR;
 110:Core/Src/radio/nrf24.c **** 
 111:Core/Src/radio/nrf24.c **** 	// Write test TX address and read TX_ADDR register
 112:Core/Src/radio/nrf24.c **** 	nRF24_WriteMBReg(nrf, nRF24_CMD_W_REGISTER | nRF24_REG_TX_ADDR, ptr, 5);
 113:Core/Src/radio/nrf24.c **** 	nRF24_ReadMBReg(nrf, nRF24_CMD_R_REGISTER | nRF24_REG_TX_ADDR, rxbuf, 5);
 114:Core/Src/radio/nrf24.c **** 
 115:Core/Src/radio/nrf24.c **** 	// Compare buffers, return error on first mismatch
 116:Core/Src/radio/nrf24.c **** 	for (i = 0; i < 5; i++) {
 117:Core/Src/radio/nrf24.c **** 		if (rxbuf[i] != *ptr++) return 0;
 118:Core/Src/radio/nrf24.c **** 	}
 119:Core/Src/radio/nrf24.c **** 
 120:Core/Src/radio/nrf24.c **** 	return 1;
 121:Core/Src/radio/nrf24.c **** 
 122:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_RF_CH, 0x02);
 123:Core/Src/radio/nrf24.c **** 	return nRF24_ReadReg(nrf, nRF24_REG_RF_CH) == 0x02;
 124:Core/Src/radio/nrf24.c **** }
