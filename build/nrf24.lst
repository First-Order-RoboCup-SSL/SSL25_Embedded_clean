 348:Core/Src/radio/nrf24.c **** 			} while (addr_width--);
 349:Core/Src/radio/nrf24.c **** 			nRF24_CSN_H(nrf);
 350:Core/Src/radio/nrf24.c **** 			break;
 351:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE2:
 352:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE3:
 353:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE4:
 354:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE5:
 355:Core/Src/radio/nrf24.c **** 			// Write address LSBbyte (only first byte from the addr buffer)
 356:Core/Src/radio/nrf24.c **** 			nRF24_WriteReg(nrf, nRF24_ADDR_REGS[pipe], *addr);
