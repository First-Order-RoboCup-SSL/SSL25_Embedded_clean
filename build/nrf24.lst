 304:Core/Src/radio/nrf24.c **** // Set automatic retransmission parameters
 305:Core/Src/radio/nrf24.c **** // input:
 306:Core/Src/radio/nrf24.c **** //   ard - auto retransmit delay, one of nRF24_ARD_xx values
 307:Core/Src/radio/nrf24.c **** //   arc - count of auto retransmits, value form 0 to 15
 308:Core/Src/radio/nrf24.c **** // note: zero arc value means that the automatic retransmission disabled
 309:Core/Src/radio/nrf24.c **** void nRF24_SetAutoRetr(const NRF24_TypeDef *nrf, uint8_t ard, uint8_t arc) {
 310:Core/Src/radio/nrf24.c **** 	// Set auto retransmit settings (SETUP_RETR register)
 311:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_SETUP_RETR, (uint8_t)((ard << 4) | (arc & nRF24_MASK_RETR_ARC)));
 312:Core/Src/radio/nrf24.c **** }
 313:Core/Src/radio/nrf24.c **** 
 314:Core/Src/radio/nrf24.c **** // Set of address widths
 315:Core/Src/radio/nrf24.c **** // input:
 316:Core/Src/radio/nrf24.c **** //   addr_width - RX/TX address field width, value from 3 to 5
 317:Core/Src/radio/nrf24.c **** // note: this setting is common for all pipes
 318:Core/Src/radio/nrf24.c **** void nRF24_SetAddrWidth(const NRF24_TypeDef *nrf, uint8_t addr_width) {
 319:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_SETUP_AW, addr_width - 2);
 320:Core/Src/radio/nrf24.c **** }
 321:Core/Src/radio/nrf24.c **** 
 322:Core/Src/radio/nrf24.c **** // Set static RX address for a specified pipe
 323:Core/Src/radio/nrf24.c **** // input:
ARM GAS  C:\Users\l1234\AppData\Local\Temp\ccFgEZ6h.s 			page 56


 324:Core/Src/radio/nrf24.c **** //   pipe - pipe to configure address, one of nRF24_PIPEx values
 325:Core/Src/radio/nrf24.c **** //   addr - pointer to the buffer with address
 326:Core/Src/radio/nrf24.c **** // note: pipe can be a number from 0 to 5 (RX pipes) and 6 (TX pipe)
 327:Core/Src/radio/nrf24.c **** // note: buffer length must be equal to current address width of transceiver
 328:Core/Src/radio/nrf24.c **** // note: for pipes[2..5] only first byte of address will be written because
 329:Core/Src/radio/nrf24.c **** //       other bytes of address equals to pipe1
 330:Core/Src/radio/nrf24.c **** // note: for pipes[2..5] only first byte of address will be written because
 331:Core/Src/radio/nrf24.c **** //       pipes 1-5 share the four most significant address bytes
 332:Core/Src/radio/nrf24.c **** void nRF24_SetAddr(const NRF24_TypeDef *nrf, uint8_t pipe, const uint8_t *addr) {
 333:Core/Src/radio/nrf24.c **** 	uint8_t addr_width;
 334:Core/Src/radio/nrf24.c **** 
 335:Core/Src/radio/nrf24.c **** 	// RX_ADDR_Px register
 336:Core/Src/radio/nrf24.c **** 	switch (pipe) {
 337:Core/Src/radio/nrf24.c **** 		case nRF24_PIPETX:
 338:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE0:
 339:Core/Src/radio/nrf24.c **** 		case nRF24_PIPE1:
 340:Core/Src/radio/nrf24.c **** 			// Get address width
 341:Core/Src/radio/nrf24.c **** 			addr_width = nRF24_ReadReg(nrf, nRF24_REG_SETUP_AW) + 1;
 342:Core/Src/radio/nrf24.c **** 			// Write address in reverse order (LSByte first)
 343:Core/Src/radio/nrf24.c **** 			addr += addr_width;
 344:Core/Src/radio/nrf24.c **** 			nRF24_CSN_L(nrf);
 345:Core/Src/radio/nrf24.c **** 			nRF24_LL_RW(nrf, nRF24_CMD_W_REGISTER | nRF24_ADDR_REGS[pipe]);
 346:Core/Src/radio/nrf24.c **** 			do {
