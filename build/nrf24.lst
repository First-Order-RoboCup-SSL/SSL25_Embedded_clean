 287:Core/Src/radio/nrf24.c **** // Set frequency channel
 288:Core/Src/radio/nrf24.c **** // input:
 289:Core/Src/radio/nrf24.c **** //   channel - radio frequency channel, value from 0 to 127
 290:Core/Src/radio/nrf24.c **** // note: frequency will be (2400 + channel)MHz
 291:Core/Src/radio/nrf24.c **** // note: PLOS_CNT[7:4] bits of the OBSERVER_TX register will be reset
 292:Core/Src/radio/nrf24.c **** void nRF24_SetRFChannel(const NRF24_TypeDef *nrf, uint8_t channel) {
 293:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_RF_CH, channel);
 294:Core/Src/radio/nrf24.c **** }
 295:Core/Src/radio/nrf24.c **** 
 296:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetRFChannel(const NRF24_TypeDef *nrf) {
 297:Core/Src/radio/nrf24.c **** 	return nRF24_ReadReg(nrf, nRF24_REG_RF_CH);
 298:Core/Src/radio/nrf24.c **** }
 299:Core/Src/radio/nrf24.c **** 
 300:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetConfig(const NRF24_TypeDef *nrf) {
