 456:Core/Src/radio/nrf24.c **** // Get value of the STATUS register
 457:Core/Src/radio/nrf24.c **** // return: value of STATUS register
 458:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetStatus(const NRF24_TypeDef *nrf) {
 459:Core/Src/radio/nrf24.c **** 	return nRF24_ReadReg(nrf, nRF24_REG_STATUS);
 460:Core/Src/radio/nrf24.c **** }
 461:Core/Src/radio/nrf24.c **** 
 462:Core/Src/radio/nrf24.c **** // Get pending IRQ flags
 463:Core/Src/radio/nrf24.c **** // return: current status of RX_DR, TX_DS and MAX_RT bits of the STATUS register
 464:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetIRQFlags(const NRF24_TypeDef *nrf) {
 465:Core/Src/radio/nrf24.c **** 	return (nRF24_ReadReg(nrf, nRF24_REG_STATUS) & nRF24_MASK_STATUS_IRQ);
 466:Core/Src/radio/nrf24.c **** }
 467:Core/Src/radio/nrf24.c **** 
 468:Core/Src/radio/nrf24.c **** // Get status of the RX FIFO
 469:Core/Src/radio/nrf24.c **** // return: one of the nRF24_STATUS_RXFIFO_xx values
 470:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetStatus_RXFIFO(const NRF24_TypeDef *nrf) {
 471:Core/Src/radio/nrf24.c **** 	return (nRF24_ReadReg(nrf, nRF24_REG_FIFO_STATUS) & nRF24_MASK_RXFIFO);
 472:Core/Src/radio/nrf24.c **** }
 473:Core/Src/radio/nrf24.c **** 
 474:Core/Src/radio/nrf24.c **** // Get status of the TX FIFO
 475:Core/Src/radio/nrf24.c **** // return: one of the nRF24_STATUS_TXFIFO_xx values
 476:Core/Src/radio/nrf24.c **** // note: the TX_REUSE bit ignored
 477:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetStatus_TXFIFO(const NRF24_TypeDef *nrf) {
 478:Core/Src/radio/nrf24.c **** 	return ((nRF24_ReadReg(nrf, nRF24_REG_FIFO_STATUS) & nRF24_MASK_TXFIFO) >> 4);
 479:Core/Src/radio/nrf24.c **** }
 480:Core/Src/radio/nrf24.c **** 
 481:Core/Src/radio/nrf24.c **** // Get pipe number for the payload available for reading from RX FIFO
 482:Core/Src/radio/nrf24.c **** // return: pipe number or 0x07 if the RX FIFO is empty
 483:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetRXSource(const NRF24_TypeDef *nrf) {
 484:Core/Src/radio/nrf24.c **** 	return ((nRF24_ReadReg(nrf, nRF24_REG_STATUS) & nRF24_MASK_RX_P_NO) >> 1);
 485:Core/Src/radio/nrf24.c **** }
 486:Core/Src/radio/nrf24.c **** 
 487:Core/Src/radio/nrf24.c **** // Get auto retransmit statistic
 488:Core/Src/radio/nrf24.c **** // return: value of OBSERVE_TX register which contains two counters encoded in nibbles:
 489:Core/Src/radio/nrf24.c **** //   high - lost packets count (max value 15, can be reseted by write to RF_CH register)
 490:Core/Src/radio/nrf24.c **** //   low  - retransmitted packets count (max value 15, reseted when new transmission starts)
 491:Core/Src/radio/nrf24.c **** uint8_t nRF24_GetRetransmitCounters(const NRF24_TypeDef *nrf) {
 492:Core/Src/radio/nrf24.c **** 	return (nRF24_ReadReg(nrf, nRF24_REG_OBSERVE_TX));
 493:Core/Src/radio/nrf24.c **** }
