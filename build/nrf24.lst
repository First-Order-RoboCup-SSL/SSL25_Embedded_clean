 272:Core/Src/radio/nrf24.c **** // Configure transceiver CRC scheme
 273:Core/Src/radio/nrf24.c **** // input:
 274:Core/Src/radio/nrf24.c **** //   scheme - CRC scheme, one of nRF24_CRC_xx values
 275:Core/Src/radio/nrf24.c **** // note: transceiver will forcibly turn on the CRC in case if auto acknowledgment
 276:Core/Src/radio/nrf24.c **** //       enabled for at least one RX pipe
 277:Core/Src/radio/nrf24.c **** void nRF24_SetCRCScheme(const NRF24_TypeDef *nrf, uint8_t scheme) {
 278:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 279:Core/Src/radio/nrf24.c **** 
 280:Core/Src/radio/nrf24.c **** 	// Configure EN_CRC[3] and CRCO[2] bits of the CONFIG register
 281:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_CONFIG);
 282:Core/Src/radio/nrf24.c **** 	reg &= ~nRF24_MASK_CRC;
 283:Core/Src/radio/nrf24.c **** 	reg |= (scheme & nRF24_MASK_CRC);
 284:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_CONFIG, reg);
 285:Core/Src/radio/nrf24.c **** }
