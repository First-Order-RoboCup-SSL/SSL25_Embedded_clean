 212:Core/Src/radio/nrf24.c **** // Control transceiver power mode
 213:Core/Src/radio/nrf24.c **** // input:
 214:Core/Src/radio/nrf24.c **** //   mode - new state of power mode, one of nRF24_PWR_xx values
 215:Core/Src/radio/nrf24.c **** void nRF24_SetPowerMode(const NRF24_TypeDef *nrf, uint8_t mode) {
 216:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 217:Core/Src/radio/nrf24.c **** 
 218:Core/Src/radio/nrf24.c **** 	reg = nRF24_ReadReg(nrf, nRF24_REG_CONFIG);
 219:Core/Src/radio/nrf24.c **** 	if (mode == nRF24_PWR_UP) {
 220:Core/Src/radio/nrf24.c **** 		// Set the PWR_UP bit of CONFIG register to wake the transceiver
 221:Core/Src/radio/nrf24.c **** 		// It goes into Stanby-I mode with consumption about 26uA
 222:Core/Src/radio/nrf24.c **** 		reg |= nRF24_CONFIG_PWR_UP;
 223:Core/Src/radio/nrf24.c **** 	} else {
 224:Core/Src/radio/nrf24.c **** 		// Clear the PWR_UP bit of CONFIG register to put the transceiver
 225:Core/Src/radio/nrf24.c **** 		// into power down mode with consumption about 900nA
 226:Core/Src/radio/nrf24.c **** 		reg &= ~nRF24_CONFIG_PWR_UP;
 227:Core/Src/radio/nrf24.c **** 	}
 228:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_CONFIG, reg);
 229:Core/Src/radio/nrf24.c **** }
 230:Core/Src/radio/nrf24.c **** 
 231:Core/Src/radio/nrf24.c **** // Set transceiver operational mode
 232:Core/Src/radio/nrf24.c **** // input:
 233:Core/Src/radio/nrf24.c **** //   mode - operational mode, one of nRF24_MODE_xx values
 234:Core/Src/radio/nrf24.c **** void nRF24_SetOperationalMode(const NRF24_TypeDef *nrf, uint8_t mode) {
 235:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 236:Core/Src/radio/nrf24.c **** 
 237:Core/Src/radio/nrf24.c **** 	// Configure PRIM_RX bit of the CONFIG register
 238:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_CONFIG);
 239:Core/Src/radio/nrf24.c **** 	reg &= ~nRF24_CONFIG_PRIM_RX;
 240:Core/Src/radio/nrf24.c **** 	reg |= (mode & nRF24_CONFIG_PRIM_RX);
 241:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_CONFIG, reg);
 242:Core/Src/radio/nrf24.c **** }
 243:Core/Src/radio/nrf24.c **** 
 244:Core/Src/radio/nrf24.c **** // Set transceiver DynamicPayloadLength feature for all the pipes
 245:Core/Src/radio/nrf24.c **** // input:
 246:Core/Src/radio/nrf24.c **** //   mode - status, one of nRF24_DPL_xx values
 247:Core/Src/radio/nrf24.c **** void nRF24_SetDynamicPayloadLength(const NRF24_TypeDef *nrf, uint8_t mode) {
 248:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 249:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_FEATURE);
 250:Core/Src/radio/nrf24.c **** 	if(mode) {
 251:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_FEATURE, reg | nRF24_FEATURE_EN_DPL);
 252:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_DYNPD, 0x1F);
 253:Core/Src/radio/nrf24.c **** 	} else {
 254:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_FEATURE, reg &~ nRF24_FEATURE_EN_DPL);
 255:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_DYNPD, 0x0);
 256:Core/Src/radio/nrf24.c **** 	}
 257:Core/Src/radio/nrf24.c **** }
 258:Core/Src/radio/nrf24.c **** 
