 364:Core/Src/radio/nrf24.c **** // Configure RF output power in TX mode
 365:Core/Src/radio/nrf24.c **** // input:
 366:Core/Src/radio/nrf24.c **** //   tx_pwr - RF output power, one of nRF24_TXPWR_xx values
 367:Core/Src/radio/nrf24.c **** void nRF24_SetTXPower(const NRF24_TypeDef *nrf, uint8_t tx_pwr) {
 368:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 369:Core/Src/radio/nrf24.c **** 
 370:Core/Src/radio/nrf24.c **** 	// Configure RF_PWR[2:1] bits of the RF_SETUP register
 371:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_RF_SETUP);
 372:Core/Src/radio/nrf24.c **** 	reg &= ~nRF24_MASK_RF_PWR;
 373:Core/Src/radio/nrf24.c **** 	reg |= tx_pwr;
 374:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_RF_SETUP, reg);
 375:Core/Src/radio/nrf24.c **** }
 376:Core/Src/radio/nrf24.c **** 
 377:Core/Src/radio/nrf24.c **** // Configure transceiver data rate
 378:Core/Src/radio/nrf24.c **** // input:
 379:Core/Src/radio/nrf24.c **** //   data_rate - data rate, one of nRF24_DR_xx values
 380:Core/Src/radio/nrf24.c **** void nRF24_SetDataRate(const NRF24_TypeDef *nrf, uint8_t data_rate) {
ARM GAS  C:\Users\l1234\AppData\Local\Temp\ccFgEZ6h.s 			page 57


 381:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 382:Core/Src/radio/nrf24.c **** 
 383:Core/Src/radio/nrf24.c **** 	// Configure RF_DR_LOW[5] and RF_DR_HIGH[3] bits of the RF_SETUP register
 384:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_RF_SETUP);
 385:Core/Src/radio/nrf24.c **** 	reg &= ~nRF24_MASK_DATARATE;
 386:Core/Src/radio/nrf24.c **** 	reg |= data_rate;
 387:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_RF_SETUP, reg);
 388:Core/Src/radio/nrf24.c **** }
 389:Core/Src/radio/nrf24.c **** 
 390:Core/Src/radio/nrf24.c **** // Configure a specified RX pipe
 391:Core/Src/radio/nrf24.c **** // input:
 392:Core/Src/radio/nrf24.c **** //   pipe - number of the RX pipe, value from 0 to 5
 393:Core/Src/radio/nrf24.c **** //   aa_state - state of auto acknowledgment, one of nRF24_AA_xx values
 394:Core/Src/radio/nrf24.c **** //   payload_len - payload length in bytes
 395:Core/Src/radio/nrf24.c **** void nRF24_SetRXPipe(const NRF24_TypeDef *nrf, uint8_t pipe, uint8_t aa_state, uint8_t payload_len)
 396:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 397:Core/Src/radio/nrf24.c **** 
 398:Core/Src/radio/nrf24.c **** 	// Enable the specified pipe (EN_RXADDR register)
 399:Core/Src/radio/nrf24.c **** 	reg = (nRF24_ReadReg(nrf, nRF24_REG_EN_RXADDR) | (1 << pipe)) & nRF24_MASK_EN_RX;
 400:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_EN_RXADDR, reg);
 401:Core/Src/radio/nrf24.c **** 
 402:Core/Src/radio/nrf24.c **** 	// Set RX payload length (RX_PW_Px register)
 403:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_RX_PW_PIPE[pipe], payload_len & nRF24_MASK_RX_PW);
 404:Core/Src/radio/nrf24.c **** 
 405:Core/Src/radio/nrf24.c **** 	// Set auto acknowledgment for a specified pipe (EN_AA register)
 406:Core/Src/radio/nrf24.c **** 	reg = nRF24_ReadReg(nrf, nRF24_REG_EN_AA);
 407:Core/Src/radio/nrf24.c **** 	if (aa_state == nRF24_AA_ON) {
 408:Core/Src/radio/nrf24.c **** 		reg |=  (1 << pipe);
 409:Core/Src/radio/nrf24.c **** 	} else {
 410:Core/Src/radio/nrf24.c **** 		reg &= ~(1 << pipe);
 411:Core/Src/radio/nrf24.c **** 	}
 412:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_EN_AA, reg);
 413:Core/Src/radio/nrf24.c **** }
 414:Core/Src/radio/nrf24.c **** 
 415:Core/Src/radio/nrf24.c **** // Disable specified RX pipe
 416:Core/Src/radio/nrf24.c **** // input:
 417:Core/Src/radio/nrf24.c **** //   PIPE - number of RX pipe, value from 0 to 5
 418:Core/Src/radio/nrf24.c **** void nRF24_ClosePipe(const NRF24_TypeDef *nrf, uint8_t pipe) {
 419:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 420:Core/Src/radio/nrf24.c **** 
 421:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_EN_RXADDR);
 422:Core/Src/radio/nrf24.c **** 	reg &= ~(1 << pipe);
 423:Core/Src/radio/nrf24.c **** 	reg &= nRF24_MASK_EN_RX;
 424:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_EN_RXADDR, reg);
 425:Core/Src/radio/nrf24.c **** }
 426:Core/Src/radio/nrf24.c **** 
 427:Core/Src/radio/nrf24.c **** // Enable the auto retransmit (a.k.a. enhanced ShockBurst) for the specified RX pipe
 428:Core/Src/radio/nrf24.c **** // input:
 429:Core/Src/radio/nrf24.c **** //   pipe - number of the RX pipe, value from 0 to 5
 430:Core/Src/radio/nrf24.c **** void nRF24_EnableAA(const NRF24_TypeDef *nrf, uint8_t pipe) {
 431:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 432:Core/Src/radio/nrf24.c **** 
 433:Core/Src/radio/nrf24.c **** 	// Set bit in EN_AA register
 434:Core/Src/radio/nrf24.c **** 	reg  = nRF24_ReadReg(nrf, nRF24_REG_EN_AA);
 435:Core/Src/radio/nrf24.c **** 	reg |= (1 << pipe);
 436:Core/Src/radio/nrf24.c **** 	nRF24_WriteReg(nrf, nRF24_REG_EN_AA, reg);
 437:Core/Src/radio/nrf24.c **** }
ARM GAS  C:\Users\l1234\AppData\Local\Temp\ccFgEZ6h.s 			page 58


 438:Core/Src/radio/nrf24.c **** 
 439:Core/Src/radio/nrf24.c **** // Disable the auto retransmit (a.k.a. enhanced ShockBurst) for one or all RX pipes
 440:Core/Src/radio/nrf24.c **** // input:
 441:Core/Src/radio/nrf24.c **** //   pipe - number of the RX pipe, value from 0 to 5, any other value will disable AA for all RX pi
 442:Core/Src/radio/nrf24.c **** void nRF24_DisableAA(const NRF24_TypeDef *nrf, uint8_t pipe) {
 443:Core/Src/radio/nrf24.c **** 	uint8_t reg;
 444:Core/Src/radio/nrf24.c **** 
 445:Core/Src/radio/nrf24.c **** 	if (pipe > 5) {
 446:Core/Src/radio/nrf24.c **** 		// Disable Auto-ACK for ALL pipes
 447:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_EN_AA, 0x00);
 448:Core/Src/radio/nrf24.c **** 	} else {
 449:Core/Src/radio/nrf24.c **** 		// Clear bit in the EN_AA register
 450:Core/Src/radio/nrf24.c **** 		reg  = nRF24_ReadReg(nrf, nRF24_REG_EN_AA);
 451:Core/Src/radio/nrf24.c **** 		reg &= ~(1 << pipe);
 452:Core/Src/radio/nrf24.c **** 		nRF24_WriteReg(nrf, nRF24_REG_EN_AA, reg);
 453:Core/Src/radio/nrf24.c **** 	}
 454:Core/Src/radio/nrf24.c **** }
