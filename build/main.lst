 193:Core/Src/main.c ****     // Map NRF24 received values to velocities
 194:Core/Src/main.c ****     float vx = currentPacket.forward_vel;  // Forward/backward
 195:Core/Src/main.c ****     float vy = currentPacket.left_vel;     // Left/right
 196:Core/Src/main.c ****     float omega = currentPacket.angular_vel; // Angular velocity
 197:Core/Src/main.c ****     
 198:Core/Src/main.c ****     // Calculate target wheel velocities using inverse kinematics
 199:Core/Src/main.c ****     float wheel_velocities[4];  // Now 4 elements
 200:Core/Src/main.c ****     BSP_InverseKinematics_Calculate(vx, vy, omega, wheel_velocities);
 201:Core/Src/main.c ****     
 202:Core/Src/main.c ****     // Get actual motor velocities from FDCAN feedback
 203:Core/Src/main.c ****     motor_feedback_t* feedback1 = BSP_MotorFeedback_GetMotorData(0);
 204:Core/Src/main.c ****     motor_feedback_t* feedback2 = BSP_MotorFeedback_GetMotorData(1);
 205:Core/Src/main.c ****     motor_feedback_t* feedback3 = BSP_MotorFeedback_GetMotorData(2);
 206:Core/Src/main.c ****     motor_feedback_t* feedback4 = BSP_MotorFeedback_GetMotorData(3);
 207:Core/Src/main.c ****     
 208:Core/Src/main.c ****     // Convert rotor speed to wheel speed by dividing by gear ratio
 209:Core/Src/main.c ****     float actual_velocity1 = feedback1 ? (feedback1->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 210:Core/Src/main.c ****     float actual_velocity2 = feedback2 ? (feedback2->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 211:Core/Src/main.c ****     float actual_velocity3 = feedback3 ? (feedback3->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
ARM GAS  C:\Users\l1234\AppData\Local\Temp\cctMEA36.s 			page 6


 212:Core/Src/main.c ****     float actual_velocity4 = feedback4 ? (feedback4->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 213:Core/Src/main.c ****     
 214:Core/Src/main.c ****     // Calculate motor outputs using PID and apply low-pass filter
 215:Core/Src/main.c ****     output1_filtered = alpha * BSP_PID_Calculate(0, wheel_velocities[0], actual_velocity1) + 
 216:Core/Src/main.c ****                       (1.0f - alpha) * output1_filtered;
 217:Core/Src/main.c ****     output2_filtered = alpha * BSP_PID_Calculate(1, wheel_velocities[1], actual_velocity2) + 
 218:Core/Src/main.c ****                       (1.0f - alpha) * output2_filtered;
 219:Core/Src/main.c ****     output3_filtered = alpha * BSP_PID_Calculate(2, wheel_velocities[2], actual_velocity3) + 
 220:Core/Src/main.c ****                       (1.0f - alpha) * output3_filtered;
 221:Core/Src/main.c ****     output4_filtered = alpha * BSP_PID_Calculate(3, wheel_velocities[3], actual_velocity4) + 
 222:Core/Src/main.c ****                       (1.0f - alpha) * output4_filtered;
 223:Core/Src/main.c ****     
 224:Core/Src/main.c ****     // Convert to CAN format (-16384 to 16384 for DM3519)
 225:Core/Src/main.c ****     int16_t output1_int = (int16_t)(output1_filtered);
 226:Core/Src/main.c ****     int16_t output2_int = (int16_t)(output2_filtered);
 227:Core/Src/main.c ****     int16_t output3_int = (int16_t)(output3_filtered);
 228:Core/Src/main.c ****     int16_t output4_int = (int16_t)(output4_filtered);
 229:Core/Src/main.c ****     
 230:Core/Src/main.c ****     // Pack data into CAN message
 231:Core/Src/main.c ****     uint8_t can_cmd[8] = {0};
 232:Core/Src/main.c ****     can_cmd[0] = (output1_int >> 8) & 0xFF;
 233:Core/Src/main.c ****     can_cmd[1] = output1_int & 0xFF;
 234:Core/Src/main.c ****     can_cmd[2] = (output2_int >> 8) & 0xFF;
 235:Core/Src/main.c ****     can_cmd[3] = output2_int & 0xFF;
 236:Core/Src/main.c ****     can_cmd[4] = (output3_int >> 8) & 0xFF;
 237:Core/Src/main.c ****     can_cmd[5] = output3_int & 0xFF;
 238:Core/Src/main.c ****     can_cmd[6] = (output4_int >> 8) & 0xFF;
 239:Core/Src/main.c ****     can_cmd[7] = output4_int & 0xFF;
 240:Core/Src/main.c ****     
 241:Core/Src/main.c ****     // Send CAN message
 242:Core/Src/main.c ****     BSP_FDCAN_Send_Message(&hfdcan3, 0x200, can_cmd, 8);
 243:Core/Src/main.c ****     
