 195:Core/Src/main.c ****     // Map NRF24 received values to velocities
 196:Core/Src/main.c ****     float vx = currentPacket.forward_vel;  // Forward/backward
 197:Core/Src/main.c ****     float vy = currentPacket.left_vel;     // Left/right
 198:Core/Src/main.c ****     float omega = currentPacket.angular_vel; // Angular velocity
 199:Core/Src/main.c ****     
 200:Core/Src/main.c ****     // Calculate target wheel velocities using inverse kinematics
 201:Core/Src/main.c ****     float wheel_velocities[4];  // Now 4 elements
 202:Core/Src/main.c ****     BSP_InverseKinematics_Calculate(vx, vy, omega, wheel_velocities);
 203:Core/Src/main.c ****     
 204:Core/Src/main.c ****     // Get actual motor velocities from FDCAN feedback
 205:Core/Src/main.c ****     motor_feedback_t* feedback1 = BSP_MotorFeedback_GetMotorData(0);
 206:Core/Src/main.c ****     motor_feedback_t* feedback2 = BSP_MotorFeedback_GetMotorData(1);
 207:Core/Src/main.c ****     motor_feedback_t* feedback3 = BSP_MotorFeedback_GetMotorData(2);
 208:Core/Src/main.c ****     motor_feedback_t* feedback4 = BSP_MotorFeedback_GetMotorData(3);
 209:Core/Src/main.c ****     
 210:Core/Src/main.c ****     // Convert rotor speed to wheel speed by dividing by gear ratio
 211:Core/Src/main.c ****     float actual_velocity1 = feedback1 ? (feedback1->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
ARM GAS  C:\Users\l1234\AppData\Local\Temp\ccK1hDgg.s 			page 6


 212:Core/Src/main.c ****     float actual_velocity2 = feedback2 ? (feedback2->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 213:Core/Src/main.c ****     float actual_velocity3 = feedback3 ? (feedback3->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 214:Core/Src/main.c ****     float actual_velocity4 = feedback4 ? (feedback4->rotor_speed * RPM_TO_RADS) / GEAR_RATIO : 0.0f
 215:Core/Src/main.c ****     
 216:Core/Src/main.c ****     // Calculate motor outputs using PID and apply low-pass filter
 217:Core/Src/main.c ****     output1_filtered = alpha * BSP_PID_Calculate(0, wheel_velocities[0], actual_velocity1) + 
 218:Core/Src/main.c ****                       (1.0f - alpha) * output1_filtered;
 219:Core/Src/main.c ****     output2_filtered = alpha * BSP_PID_Calculate(1, wheel_velocities[1], actual_velocity2) + 
 220:Core/Src/main.c ****                       (1.0f - alpha) * output2_filtered;
 221:Core/Src/main.c ****     output3_filtered = alpha * BSP_PID_Calculate(2, wheel_velocities[2], actual_velocity3) + 
 222:Core/Src/main.c ****                       (1.0f - alpha) * output3_filtered;
 223:Core/Src/main.c ****     output4_filtered = alpha * BSP_PID_Calculate(3, wheel_velocities[3], actual_velocity4) + 
 224:Core/Src/main.c ****                       (1.0f - alpha) * output4_filtered;
 225:Core/Src/main.c ****     
 226:Core/Src/main.c ****     // Convert to CAN format (-16384 to 16384 for DM3519)
 227:Core/Src/main.c ****     int16_t output1_int = (int16_t)(output1_filtered);
 228:Core/Src/main.c ****     int16_t output2_int = (int16_t)(output2_filtered);
 229:Core/Src/main.c ****     int16_t output3_int = (int16_t)(output3_filtered);
 230:Core/Src/main.c ****     int16_t output4_int = (int16_t)(output4_filtered);
 231:Core/Src/main.c ****     
 232:Core/Src/main.c ****     // Pack data into CAN message
 233:Core/Src/main.c ****     uint8_t can_cmd[8] = {0};
 234:Core/Src/main.c ****     can_cmd[0] = (output1_int >> 8) & 0xFF;
 235:Core/Src/main.c ****     can_cmd[1] = output1_int & 0xFF;
 236:Core/Src/main.c ****     can_cmd[2] = (output2_int >> 8) & 0xFF;
 237:Core/Src/main.c ****     can_cmd[3] = output2_int & 0xFF;
 238:Core/Src/main.c ****     can_cmd[4] = (output3_int >> 8) & 0xFF;
 239:Core/Src/main.c ****     can_cmd[5] = output3_int & 0xFF;
 240:Core/Src/main.c ****     can_cmd[6] = (output4_int >> 8) & 0xFF;
 241:Core/Src/main.c ****     can_cmd[7] = output4_int & 0xFF;
 242:Core/Src/main.c ****     
 243:Core/Src/main.c ****     // Send CAN message
 244:Core/Src/main.c ****     BSP_FDCAN_Send_Message(&hfdcan3, 0x200, can_cmd, 8);
 245:Core/Src/main.c ****     
 246:Core/Src/main.c ****     HAL_Delay(CONTROL_PERIOD_MS);
 247:Core/Src/main.c ****   }
