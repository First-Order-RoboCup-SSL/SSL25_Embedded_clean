 133:Bsp/Src/bsp_fdcan.c **** /**
 134:Bsp/Src/bsp_fdcan.c ****   * @brief  Process received feedback message
 135:Bsp/Src/bsp_fdcan.c ****   * @param  rx_header: Pointer to CAN message header
 136:Bsp/Src/bsp_fdcan.c ****   * @param  data: Pointer to received data
 137:Bsp/Src/bsp_fdcan.c ****   * @retval None
 138:Bsp/Src/bsp_fdcan.c ****   */
 139:Bsp/Src/bsp_fdcan.c **** static void ProcessFeedbackMessage(FDCAN_RxHeaderTypeDef *rx_header, uint8_t *data)
 140:Bsp/Src/bsp_fdcan.c **** {
 141:Bsp/Src/bsp_fdcan.c ****     // Get motor ID from CAN ID (0x201 -> 1, 0x202 -> 2, etc.)
 142:Bsp/Src/bsp_fdcan.c ****     uint8_t motor_id = rx_header->Identifier - 0x200;
 143:Bsp/Src/bsp_fdcan.c ****     
 144:Bsp/Src/bsp_fdcan.c ****     // Process through motor feedback system if it's a valid motor ID
 145:Bsp/Src/bsp_fdcan.c ****     if(motor_id >= 1 && motor_id <= 4) {
 146:Bsp/Src/bsp_fdcan.c ****         BSP_MotorFeedback_ProcessMessage(motor_id, data);
 147:Bsp/Src/bsp_fdcan.c ****     }
 148:Bsp/Src/bsp_fdcan.c **** }
